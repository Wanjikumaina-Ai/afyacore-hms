{
  "appId": "com.afyacore.hms.client",
  "productName": "AfyaCore HMS",
  "copyright": "Copyright © 2026 AfyaCore",
  "extraMetadata": {
    "main": "electron/client/main.cjs"
  },
  "directories": {
    "buildResources": "electron/assets",
    "output": "dist-electron/client"
  },
  "files": [
    "electron/client/**/*",
    "electron/shared/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/.cache/**/*",
    "!node_modules/.vite/**/*",
    "!node_modules/**/*.map",
    "!node_modules/**/test/**/*",
    "!node_modules/**/tests/**/*",
    "!node_modules/**/__tests__/**/*",
    "!node_modules/**/docs/**/*",
    "!node_modules/**/examples/**/*",
    "!node_modules/**/*.md",
    "!node_modules/**/*.ts",
    "!node_modules/electron/**/*",
    "!node_modules/electron-builder/**/*",
    "!node_modules/vite/**/*",
    "!node_modules/@vitejs/**/*",
    "!node_modules/typescript/**/*",
    "!node_modules/vitest/**/*",
    "!node_modules/@react-router/**/*",
    "!node_modules/react-router/**/*",
    "!node_modules/@hono/**/*",
    "!node_modules/hono/**/*",
    "!node_modules/sql.js/**/*",
    "!node_modules/bcryptjs/**/*"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "asar": false,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "electron/icon.ico",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AfyaCore HMS",
    "installerIcon": "electron/icon.ico",
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
    "icon": "electron/icon.icns",
    "category": "public.app-category.medical"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "electron/icon.png",
    "category": "MedicalSoftware"
  }
}